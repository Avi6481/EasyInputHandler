      <EnableUAC>false</EnableUAC>
      <AdditionalLibraryDirectories>$(SdlDir)lib\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL3.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>SDL3.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
    <PostBuildEvent>
      <Command>xcopy /Y /D "$(SdlDir)lib\x64\SDL3.dll" "$(OutDir)"
if not exist "$(GameDir)r6\scripts\EasyTrainer" mkdir "$(GameDir)r6\scripts\EasyTrainer"
copy /Y "$(ProjectDir)RedScript\EasyTrainerInputHandler.reds" "$(GameDir)r6\scripts\EasyTrainer\EasyInputHandler.reds"</Command>
      <Message>Copying SDL3.dll and the REDscript class into the game folder</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
